# Copy to .env.local for local dev, and set the same values in
# Vercel → Project → Settings → Environment Variables for production.

# REQUIRED. Signs the one-time login codes. Must be at least 16 characters.
# There is no default: if this is missing or too short, /api/send-otp and
# /api/verify-otp return 500 rather than falling back to a guessable secret.
# Generate one with:  openssl rand -hex 32
OTP_SECRET=

# REQUIRED. The only email allowed to receive an owner login code.
OWNER_EMAIL=

# REQUIRED. Resend API key used to deliver the login code.
RESEND_API_KEY=

# REQUIRED for the kitchen assistant. Anthropic API key used by /api/chat.
API_KEY=

# OPTIONAL but strongly recommended in production. Without these, rate limits
# are counted per serverless instance, so limits are enforced only loosely.
# Create a free Redis database at https://upstash.com and paste its REST creds.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
